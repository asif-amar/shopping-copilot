# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require

# JWT Authentication Configuration
# IMPORTANT: Generate a strong, random secret key for production!
# You can use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth Configuration
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Environment Configuration
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Logging Configuration
LOG_LEVEL=INFO

# Server Configuration  
HOST=0.0.0.0
PORT=8000

# Proxy Configuration (Optional - for web scraping)
PROXY_URL=your_proxy_url_here
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password
USE_PROXY=false